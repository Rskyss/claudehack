<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>local.claude-residential-split</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__USER_HOME__/.config/claude-residential/split_proxy.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__USER_HOME__/.config/claude-residential/split_proxy.log</string>
	<key>StandardOutPath</key>
	<string>__USER_HOME__/.config/claude-residential/split_proxy.log</string>
</dict>
</plist>
